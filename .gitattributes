# Fichiers texte Unity : fins de ligne normalisées, fusion YAML intelligente possible
* text=auto
*.cs text diff=csharp
*.shader text
*.hlsl text
*.asmdef text
*.json text
*.md text
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text eol=lf

# Binaires
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.fbx binary
